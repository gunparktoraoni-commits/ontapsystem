{
  "name": "ontapnewsystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:webpack": "node scripts/dev.mjs --webpack",
    "build": "npm run db:generate && node scripts/production-build.mjs",
    "visual:check": "node scripts/visual-check.js",
    "test:e2e": "npx playwright test",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "verify:theme-location": "node scripts/verify-theme-location-gates.mjs",
    "db:push": "npx prisma db push",
    "db:generate": "prisma generate && prisma generate --schema=prisma/analytics.prisma",
    "postinstall": "npm run db:generate",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "theme:create": "npx tsx scripts/create-theme-record.ts",
    "backfill:affiliates": "npx tsx scripts/backfill-affiliates.ts",
    "test-accounts": "tsx scripts/manage-test-accounts.ts",
    "migrate:new:schema": "node scripts/migrate-new-databases/deploy-schema.mjs",
    "migrate:new:portal": "npx tsx scripts/migrate-new-databases/run.mts --phase portal",
    "migrate:new:overlay-main": "npx tsx scripts/migrate-new-databases/run.mts --phase overlay-main",
    "migrate:new:overlay-analytics": "npx tsx scripts/migrate-new-databases/run.mts --phase overlay-analytics",
    "migrate:new:verify": "npx tsx scripts/migrate-new-databases/run.mts --phase verify",
    "migrate:new:all": "npx tsx scripts/migrate-new-databases/run.mts --phase all",
    "migrate:new:portal-merge": "npx tsx scripts/migrate-new-databases/run-portal-merge.mts",
    "migrate:new:diagnose": "npx tsx scripts/migrate-new-databases/diagnose-alias.mts",
    "migrate:new:fix-orphans": "npx tsx scripts/migrate-new-databases/fix-orphan-bizcards.mts",
    "migrate:new:fix-pending-portfolios": "npx tsx scripts/migrate-new-databases/fix-pending-portfolios.mts",
    "migrate:user-serial-to-bizcard": "npx tsx scripts/migrate-user-serial-to-bizcard.mts",
    "verify:hostinger": "node scripts/verify-hostinger-deploy.mjs",
    "migration:help": "npx tsx migration-system/index.ts help",
    "migration:status": "npx tsx migration-system/index.ts status",
    "migration:dry-run": "npx tsx migration-system/index.ts dry-run",
    "migration:purge-cloudinary": "npx tsx migration-system/index.ts purge-cloudinary",
    "migration:migrate": "npx tsx migration-system/index.ts migrate",
    "migration:rollback": "npx tsx migration-system/index.ts rollback",
    "migration:uninstall": "npx tsx migration-system/index.ts uninstall",
    "test:migration-system": "npx tsx tests/migration-system/ownership-verifier.test.ts && npx tsx tests/migration-system/id-resolver.test.ts && npx tsx tests/migration-system/media-url-cleaner.test.ts && npx tsx tests/migration-system/file-scanner.test.ts",
    "analyze:media": "npx tsx scripts/analyze-media-records.ts",
    "migrate:cloudinary:test": "npx tsx scripts/migrate-cloudinary-to-r2.ts 10 --dry-run",
    "migrate:cloudinary": "npx tsx scripts/migrate-cloudinary-to-r2.ts",
    "migrate:cloudinary:resume": "npx tsx scripts/migrate-cloudinary-to-r2.ts -- --resume",
    "migrate:cloudinary:fresh": "npx tsx scripts/migrate-cloudinary-to-r2.ts -- --fresh",
    "migrate:cloudinary:offline": "npx tsx scripts/migrate-cloudinary-to-r2-offline.ts",
    "test:db:connection": "npx tsx scripts/test-database-connection.ts",
    "cleanup:cloudinary:test": "npx tsx scripts/cleanup-cloudinary-urls.ts --dry-run",
    "cleanup:cloudinary": "npx tsx scripts/cleanup-cloudinary-urls.ts",
    "restore:cloudinary:file-urls": "npx tsx scripts/restore-cloudinary-file-urls.ts",
    "restore:cloudinary:file-urls:dry-run": "npx tsx scripts/restore-cloudinary-file-urls.ts --dry-run",
    "cleanup:r2:test": "npx tsx scripts/cleanup-r2-bucket.ts --dry-run",
    "cleanup:r2": "npx tsx scripts/cleanup-r2-bucket.ts --force",
    "validate:media": "npx tsx scripts/validate-and-remap-media.ts",
    "cleanup:r2:list": "npx tsx scripts/cleanup-r2-bucket.ts",
    "test:migration:setup": "npx tsx scripts/test-migration-setup.ts",
    "check:env": "node scripts/check-env.js",
    "sync:media:db": "npx tsx scripts/sync-media-from-database.ts",
    "reconcile:media:map-emails": "npx tsx scripts/reconcile-media.ts map-emails",
    "reconcile:media:reconcile": "npx tsx scripts/reconcile-media.ts reconcile",
    "reconcile:media:update": "npx tsx scripts/reconcile-media.ts update",
    "reconcile:media:help": "npx tsx scripts/reconcile-media.ts --help",
    "reconcile:media:examples": "npx tsx examples/media-reconciliation-examples.ts",
    "migrate:social-links": "npx tsx scripts/migrate-social-links.ts",
    "migrate:social-links:dry-run": "npx tsx scripts/migrate-social-links.ts --dry-run",
    "migrate:social-links:retry": "npx tsx scripts/retry-social-links.ts",
    "verify:social-migration": "npx tsx scripts/verify-social-migration-setup.ts"
  },
