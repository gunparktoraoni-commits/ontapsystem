  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "mysql2": "^3.23.3",
    "prisma": "6.19.3",
    "shadcn": "^4.0.8",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
