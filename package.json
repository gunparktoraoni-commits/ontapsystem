    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@upstash/redis": "^1.35.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fast-average-color": "^9.5.2",
    "framer-motion": "^12.36.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.9",
