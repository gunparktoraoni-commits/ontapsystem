# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next.config.compiled.js
*.next.config

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test-account manifest (optional)
scripts/.test-accounts.local.json

# migration and script artifacts
migration-system/
scripts/*
!scripts/production-build.mjs
!scripts/patch-theme-address.mjs
!scripts/verify-next-build.mjs

databases/
public/uploads*.zip
*.sql
!prisma/migrations/20260808_add_direct_message_metadata/
